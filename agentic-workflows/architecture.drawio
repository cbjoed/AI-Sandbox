<mxfile host="app.diagrams.net" version="25.0.3"><diagram id="agent-context" name="1 - System Context"><mxGraphModel dx="1100" dy="700" grid="1" gridSize="10" page="1" pageWidth="1100" pageHeight="700"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Agentic Workflows — C4 System Context (proposed)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#172554;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="760" height="34" as="geometry"/></mxCell><mxCell id="note" value="Initial architecture from the project brief; implementation choices are intentionally open." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="30" y="55" width="850" height="24" as="geometry"/></mxCell><mxCell id="boundary" value="AI Agent System" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingTop=10;spacingLeft=12;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="310" y="145" width="440" height="350" as="geometry"/></mxCell><mxCell id="user" value="&lt;b&gt;Operator&lt;/b&gt;&lt;br&gt;Person&lt;br&gt;Submits multi-step tasks and reviews results" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#08427B;fontColor=#FFFFFF;strokeColor=#052E56;fontSize=13;" vertex="1" parent="1"><mxGeometry x="55" y="260" width="190" height="125" as="geometry"/></mxCell><mxCell id="agent" value="&lt;b&gt;Agent application&lt;/b&gt;&lt;br&gt;Software system&lt;br&gt;Plans work, invokes approved tools, and returns a result" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;fontColor=#FFFFFF;strokeColor=#0B4884;fontSize=13;" vertex="1" parent="1"><mxGeometry x="420" y="260" width="230" height="120" as="geometry"/></mxCell><mxCell id="llm" value="&lt;b&gt;LLM provider&lt;/b&gt;&lt;br&gt;External software system&lt;br&gt;Generates plans and tool-call requests" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5A623;fontColor=#1F2937;strokeColor=#C47A00;fontSize=13;" vertex="1" parent="1"><mxGeometry x="835" y="170" width="210" height="105" as="geometry"/></mxCell><mxCell id="tools" value="&lt;b&gt;Approved tool services&lt;/b&gt;&lt;br&gt;External systems&lt;br&gt;Web search, calculator, and explicitly permitted workspace access" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5A623;fontColor=#1F2937;strokeColor=#C47A00;fontSize=13;" vertex="1" parent="1"><mxGeometry x="835" y="365" width="210" height="120" as="geometry"/></mxCell><mxCell id="e1" value="submits task / receives answer" style="endArrow=block;html=1;rounded=0;strokeColor=#334155;fontSize=11;" edge="1" parent="1" source="user" target="agent"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="plan and tool-call exchange" style="endArrow=block;html=1;rounded=0;strokeColor=#334155;fontSize=11;" edge="1" parent="1" source="agent" target="llm"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="executes allow-listed actions" style="endArrow=block;html=1;rounded=0;strokeColor=#334155;fontSize=11;" edge="1" parent="1" source="agent" target="tools"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="legend" value="C4: Person • Software System • External System | Security boundary: tools are allow-listed, least-privilege, and bounded by step/time limits." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="30" y="625" width="1020" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="agent-containers" name="2 - Containers"><mxGraphModel dx="1100" dy="700" grid="1" gridSize="10" page="1" pageWidth="1100" pageHeight="700"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Agentic Workflows — C4 Container Diagram (proposed)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#172554;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="800" height="34" as="geometry"/></mxCell><mxCell id="note" value="Control plane owns policy and orchestration; tool adapters isolate provider-specific interfaces." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="30" y="55" width="850" height="24" as="geometry"/></mxCell><mxCell id="boundary" value="Agent application (Python CLI / service)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingTop=10;spacingLeft=12;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="250" y="125" width="590" height="455" as="geometry"/></mxCell><mxCell id="user" value="&lt;b&gt;Operator&lt;/b&gt;&lt;br&gt;Person" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#08427B;fontColor=#FFFFFF;strokeColor=#052E56;fontSize=13;" vertex="1" parent="1"><mxGeometry x="35" y="270" width="155" height="110" as="geometry"/></mxCell><mxCell id="cli" value="&lt;b&gt;Task interface&lt;/b&gt;&lt;br&gt;CLI / thin UI&lt;br&gt;Accepts tasks; presents final response" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;fontColor=#FFFFFF;strokeColor=#0B4884;fontSize=12;" vertex="1" parent="1"><mxGeometry x="290" y="270" width="160" height="105" as="geometry"/></mxCell><mxCell id="runtime" value="&lt;b&gt;Agent runtime&lt;/b&gt;&lt;br&gt;Application container&lt;br&gt;Plan–act–observe loop; enforces max steps, timeout, and approval policy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;fontColor=#FFFFFF;strokeColor=#0B4884;fontSize=12;" vertex="1" parent="1"><mxGeometry x="510" y="260" width="205" height="125" as="geometry"/></mxCell><mxCell id="registry" value="&lt;b&gt;Tool registry + adapters&lt;/b&gt;&lt;br&gt;Application module&lt;br&gt;Allow-listed, typed tool interfaces; validate inputs and outputs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;fontColor=#FFFFFF;strokeColor=#0B4884;fontSize=12;" vertex="1" parent="1"><mxGeometry x="510" y="430" width="205" height="105" as="geometry"/></mxCell><mxCell id="logs" value="&lt;b&gt;Run log&lt;/b&gt;&lt;br&gt;Local structured records&lt;br&gt;Step, action, observation, and errors; redact secrets" style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="290" y="435" width="160" height="95" as="geometry"/></mxCell><mxCell id="model" value="&lt;b&gt;LLM provider&lt;/b&gt;&lt;br&gt;External API&lt;br&gt;Tool/function-call capable model" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5A623;fontColor=#1F2937;strokeColor=#C47A00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="885" y="205" width="185" height="100" as="geometry"/></mxCell><mxCell id="tools" value="&lt;b&gt;Tool endpoints&lt;/b&gt;&lt;br&gt;External services / workspace&lt;br&gt;Search, calculator, or scoped file access" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5A623;fontColor=#1F2937;strokeColor=#C47A00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="885" y="405" width="185" height="110" as="geometry"/></mxCell><mxCell id="e1" value="task / response" style="endArrow=block;html=1;strokeColor=#334155;fontSize=10;" edge="1" parent="1" source="user" target="cli"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="task and result" style="endArrow=block;html=1;strokeColor=#334155;fontSize=10;" edge="1" parent="1" source="cli" target="runtime"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="model requests" style="endArrow=block;html=1;strokeColor=#334155;fontSize=10;" edge="1" parent="1" source="runtime" target="model"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="validated tool calls" style="endArrow=block;html=1;strokeColor=#334155;fontSize=10;" edge="1" parent="1" source="runtime" target="registry"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="permitted operations" style="endArrow=block;html=1;strokeColor=#334155;fontSize=10;" edge="1" parent="1" source="registry" target="tools"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="append redacted events" style="endArrow=block;html=1;strokeColor=#334155;fontSize=10;" edge="1" parent="1" source="runtime" target="logs"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="legend" value="Keep tools least-privilege and auditable. Store credentials outside code; cap retries, cost, and execution time." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="30" y="625" width="1020" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>