<mxfile host="app.diagrams.net" version="25.0.3"><diagram id="agent-components" name="3 - Components"><mxGraphModel dx="1100" dy="700" grid="1" gridSize="10" page="1" pageWidth="1100" pageHeight="700"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Agentic Workflows — C4 Component Diagram" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=20;fontStyle=1;fontColor=#172554;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="800" height="34" as="geometry"/></mxCell><mxCell id="n" value="Zoom into the Agent Runtime container shown in architecture.drawio; components are logical modules, not committed implementation choices." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=12;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="30" y="55" width="960" height="24" as="geometry"/></mxCell><mxCell id="b" value="Agent Runtime container" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingTop=10;spacingLeft=12;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="205" y="120" width="660" height="465" as="geometry"/></mxCell><mxCell id="in" value="&lt;b&gt;Task interface&lt;/b&gt;&lt;br&gt;Accepts task and returns result" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;fontColor=#FFFFFF;strokeColor=#0B4884;fontSize=12;" vertex="1" parent="1"><mxGeometry x="250" y="205" width="170" height="90" as="geometry"/></mxCell><mxCell id="loop" value="&lt;b&gt;Agent loop&lt;/b&gt;&lt;br&gt;Maintains state; alternates planning, action, observation; stops on completion or limit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;fontColor=#FFFFFF;strokeColor=#0B4884;fontSize=12;" vertex="1" parent="1"><mxGeometry x="475" y="195" width="190" height="110" as="geometry"/></mxCell><mxCell id="guard" value="&lt;b&gt;Policy + budget guard&lt;/b&gt;&lt;br&gt;Checks allow-list, approval, max steps, timeout, and input schema" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;fontColor=#FFFFFF;strokeColor=#0B4884;fontSize=12;" vertex="1" parent="1"><mxGeometry x="700" y="205" width="145" height="90" as="geometry"/></mxCell><mxCell id="modeladapter" value="&lt;b&gt;LLM adapter&lt;/b&gt;&lt;br&gt;Provider-neutral prompt and tool-call interface" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;fontColor=#FFFFFF;strokeColor=#0B4884;fontSize=12;" vertex="1" parent="1"><mxGeometry x="250" y="390" width="170" height="90" as="geometry"/></mxCell><mxCell id="tooladapter" value="&lt;b&gt;Tool registry / adapters&lt;/b&gt;&lt;br&gt;Typed, allow-listed tool calls; scoped credentials and workspace access" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;fontColor=#FFFFFF;strokeColor=#0B4884;fontSize=12;" vertex="1" parent="1"><mxGeometry x="475" y="380" width="190" height="105" as="geometry"/></mxCell><mxCell id="log" value="&lt;b&gt;Run event logger&lt;/b&gt;&lt;br&gt;Append-only structured events; redact secrets" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;fontColor=#FFFFFF;strokeColor=#0B4884;fontSize=12;" vertex="1" parent="1"><mxGeometry x="700" y="390" width="145" height="90" as="geometry"/></mxCell><mxCell id="model" value="&lt;b&gt;LLM provider&lt;/b&gt;&lt;br&gt;External API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5A623;fontColor=#1F2937;strokeColor=#C47A00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="370" width="145" height="90" as="geometry"/></mxCell><mxCell id="tools" value="&lt;b&gt;Approved tool endpoints&lt;/b&gt;&lt;br&gt;Search, calculator, scoped files" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5A623;fontColor=#1F2937;strokeColor=#C47A00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="915" y="370" width="155" height="95" as="geometry"/></mxCell><mxCell id="e1" value="task / result" style="endArrow=block;html=1;strokeColor=#334155;fontSize=10;" edge="1" parent="1" source="in" target="loop"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="policy check" style="endArrow=block;html=1;strokeColor=#334155;fontSize=10;" edge="1" parent="1" source="loop" target="guard"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="plan / tool-call request" style="endArrow=block;html=1;strokeColor=#334155;fontSize=10;" edge="1" parent="1" source="loop" target="modeladapter"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="provider API" style="endArrow=block;html=1;strokeColor=#334155;fontSize=10;" edge="1" parent="1" source="modeladapter" target="model"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="authorized action" style="endArrow=block;html=1;strokeColor=#334155;fontSize=10;" edge="1" parent="1" source="guard" target="tooladapter"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="execute action" style="endArrow=block;html=1;strokeColor=#334155;fontSize=10;" edge="1" parent="1" source="tooladapter" target="tools"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="redacted events" style="endArrow=block;html=1;strokeColor=#334155;fontSize=10;" edge="1" parent="1" source="loop" target="log"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f" value="C4 Component view: modules belong to the runtime container; each dependency is explicit and replaceable." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="30" y="625" width="1020" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="agent-dynamic" name="4 - Dynamic - Tool-Using Task"><mxGraphModel dx="1100" dy="700" grid="1" gridSize="10" page="1" pageWidth="1100" pageHeight="700"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Agentic Workflows — Dynamic Diagram: Tool-Using Task" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=20;fontStyle=1;fontColor=#172554;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="900" height="34" as="geometry"/></mxCell><mxCell id="n" value="Numbered interactions illustrate one bounded run; the LLM proposes actions, while local policy decides whether they may execute." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=12;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="30" y="55" width="1000" height="24" as="geometry"/></mxCell><mxCell id="u" value="&lt;b&gt;Operator&lt;/b&gt;&lt;br&gt;Person" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#08427B;fontColor=#FFFFFF;strokeColor=#052E56;fontSize=12;" vertex="1" parent="1"><mxGeometry x="25" y="225" width="135" height="100" as="geometry"/></mxCell><mxCell id="ui" value="&lt;b&gt;Task interface&lt;/b&gt;&lt;br&gt;CLI / UI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;fontColor=#FFFFFF;strokeColor=#0B4884;fontSize=12;" vertex="1" parent="1"><mxGeometry x="205" y="225" width="145" height="100" as="geometry"/></mxCell><mxCell id="agent" value="&lt;b&gt;Agent loop&lt;/b&gt;&lt;br&gt;State + step budget" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;fontColor=#FFFFFF;strokeColor=#0B4884;fontSize=12;" vertex="1" parent="1"><mxGeometry x="395" y="225" width="150" height="100" as="geometry"/></mxCell><mxCell id="llm" value="&lt;b&gt;LLM provider&lt;/b&gt;&lt;br&gt;External system" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5A623;fontColor=#1F2937;strokeColor=#C47A00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="590" y="225" width="150" height="100" as="geometry"/></mxCell><mxCell id="policy" value="&lt;b&gt;Policy + tool gateway&lt;/b&gt;&lt;br&gt;Local component" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;fontColor=#FFFFFF;strokeColor=#0B4884;fontSize=12;" vertex="1" parent="1"><mxGeometry x="785" y="225" width="150" height="100" as="geometry"/></mxCell><mxCell id="service" value="&lt;b&gt;Approved tool&lt;/b&gt;&lt;br&gt;External service / workspace" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5A623;fontColor=#1F2937;strokeColor=#C47A00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="975" y="225" width="120" height="100" as="geometry"/></mxCell><mxCell id="e1" value="1. Submit task" style="endArrow=block;html=1;strokeColor=#334155;fontSize=10;" edge="1" parent="1" source="u" target="ui"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="2. Start bounded run" style="endArrow=block;html=1;strokeColor=#334155;fontSize=10;" edge="1" parent="1" source="ui" target="agent"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="3. Request next action" style="endArrow=block;html=1;strokeColor=#334155;fontSize=10;" edge="1" parent="1" source="agent" target="llm"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="4. Return tool-call proposal" style="endArrow=block;html=1;strokeColor=#334155;fontSize=10;" edge="1" parent="1" source="llm" target="policy"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="5. Validate + execute allow-listed call" style="endArrow=block;html=1;strokeColor=#334155;fontSize=10;" edge="1" parent="1" source="policy" target="service"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="6. Return observation; loop or stop at limit" style="endArrow=block;html=1;strokeColor=#334155;fontSize=10;" edge="1" parent="1" source="service" target="agent"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="7. Present final answer" style="endArrow=block;html=1;strokeColor=#334155;fontSize=10;" edge="1" parent="1" source="agent" target="ui"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="8. Review result" style="endArrow=block;html=1;strokeColor=#334155;fontSize=10;" edge="1" parent="1" source="ui" target="u"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f" value="Dynamic view: one representative collaboration, not a deployment or a guarantee that every run uses every tool." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="30" y="625" width="1020" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>