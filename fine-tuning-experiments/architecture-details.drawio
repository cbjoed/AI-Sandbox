<mxfile host="app.diagrams.net" version="25.0.3"><diagram id="tune-components" name="3 - Components"><mxGraphModel dx="1100" dy="700" grid="1" gridSize="10" page="1" pageWidth="1100" pageHeight="700"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Fine-Tuning Experiments — C4 Component Diagram" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=20;fontStyle=1;fontColor=#172554;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="850" height="34" as="geometry"/></mxCell><mxCell id="n" value="Zoom into the training/evaluation workflow from architecture.drawio; components are logical responsibilities." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=12;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="30" y="55" width="900" height="24" as="geometry"/></mxCell><mxCell id="b" value="Experiment pipeline" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingTop=10;spacingLeft=12;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="205" y="120" width="680" height="465" as="geometry"/></mxCell><mxCell id="cfg" value="&lt;b&gt;Run configuration&lt;/b&gt;&lt;br&gt;Pinned model, seed, hyperparameters, data version" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;fontColor=#FFFFFF;strokeColor=#0B4884;fontSize=12;" vertex="1" parent="1"><mxGeometry x="250" y="190" width="175" height="95" as="geometry"/></mxCell><mxCell id="valid" value="&lt;b&gt;Dataset validator&lt;/b&gt;&lt;br&gt;Schema/label checks, deduplication, leakage checks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;fontColor=#FFFFFF;strokeColor=#0B4884;fontSize=12;" vertex="1" parent="1"><mxGeometry x="495" y="190" width="180" height="95" as="geometry"/></mxCell><mxCell id="split" value="&lt;b&gt;Split + formatter&lt;/b&gt;&lt;br&gt;Train/validation/test split; model input format" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;fontColor=#FFFFFF;strokeColor=#0B4884;fontSize=12;" vertex="1" parent="1"><mxGeometry x="710" y="190" width="150" height="95" as="geometry"/></mxCell><mxCell id="trainer" value="&lt;b&gt;Trainer&lt;/b&gt;&lt;br&gt;Full fine-tune or LoRA; emits adapter/checkpoint and run metadata" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;fontColor=#FFFFFF;strokeColor=#0B4884;fontSize=12;" vertex="1" parent="1"><mxGeometry x="335" y="385" width="190" height="105" as="geometry"/></mxCell><mxCell id="eval" value="&lt;b&gt;Evaluation runner&lt;/b&gt;&lt;br&gt;Runs base and tuned models on the same held-out cases" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;fontColor=#FFFFFF;strokeColor=#0B4884;fontSize=12;" vertex="1" parent="1"><mxGeometry x="600" y="385" width="200" height="105" as="geometry"/></mxCell><mxCell id="data" value="&lt;b&gt;Curated dataset&lt;/b&gt;&lt;br&gt;Versioned source records" style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="190" width="145" height="90" as="geometry"/></mxCell><mxCell id="art" value="&lt;b&gt;Experiment artifacts&lt;/b&gt;&lt;br&gt;Adapter, manifests, metrics, report" style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="900" y="390" width="170" height="100" as="geometry"/></mxCell><mxCell id="compute" value="&lt;b&gt;Base model + GPU runtime&lt;/b&gt;&lt;br&gt;Pinned weights and training compute" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5A623;fontColor=#1F2937;strokeColor=#C47A00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="395" width="180" height="100" as="geometry"/></mxCell><mxCell id="e1" value="source records" style="endArrow=block;html=1;strokeColor=#334155;fontSize=10;" edge="1" parent="1" source="data" target="valid"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="validated data" style="endArrow=block;html=1;strokeColor=#334155;fontSize=10;" edge="1" parent="1" source="valid" target="split"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="run specification" style="endArrow=block;html=1;strokeColor=#334155;fontSize=10;" edge="1" parent="1" source="cfg" target="valid"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="train split + config" style="endArrow=block;html=1;strokeColor=#334155;fontSize=10;" edge="1" parent="1" source="split" target="trainer"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="base weights / compute" style="endArrow=block;html=1;strokeColor=#334155;fontSize=10;" edge="1" parent="1" source="compute" target="trainer"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="base + tuned inference; test split" style="endArrow=block;html=1;strokeColor=#334155;fontSize=10;" edge="1" parent="1" source="trainer" target="eval"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="versioned results" style="endArrow=block;html=1;strokeColor=#334155;fontSize=10;" edge="1" parent="1" source="eval" target="art"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f" value="Keep test data isolated; pin model, dataset, training configuration, and software environment for each run." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="30" y="625" width="1020" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="tune-dynamic" name="4 - Dynamic - Train and Compare"><mxGraphModel dx="1100" dy="700" grid="1" gridSize="10" page="1" pageWidth="1100" pageHeight="700"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Fine-Tuning Experiments — Dynamic Diagram: Train and Compare" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=20;fontStyle=1;fontColor=#172554;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="950" height="34" as="geometry"/></mxCell><mxCell id="n" value="Shows the happy path for one reproducible run; held-out cases are evaluated only after training." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=12;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="30" y="55" width="900" height="24" as="geometry"/></mxCell><mxCell id="user" value="&lt;b&gt;Practitioner&lt;/b&gt;&lt;br&gt;Person" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#08427B;fontColor=#FFFFFF;strokeColor=#052E56;fontSize=12;" vertex="1" parent="1"><mxGeometry x="25" y="225" width="135" height="100" as="geometry"/></mxCell><mxCell id="data" value="&lt;b&gt;Dataset prep&lt;/b&gt;&lt;br&gt;Validate + split" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;fontColor=#FFFFFF;strokeColor=#0B4884;fontSize=12;" vertex="1" parent="1"><mxGeometry x="205" y="225" width="145" height="100" as="geometry"/></mxCell><mxCell id="train" value="&lt;b&gt;Training job&lt;/b&gt;&lt;br&gt;Pinned config + base model" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;fontColor=#FFFFFF;strokeColor=#0B4884;fontSize=12;" vertex="1" parent="1"><mxGeometry x="395" y="225" width="150" height="100" as="geometry"/></mxCell><mxCell id="artifact" value="&lt;b&gt;Adapter + manifest&lt;/b&gt;&lt;br&gt;Versioned artifact" style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="590" y="225" width="150" height="100" as="geometry"/></mxCell><mxCell id="eval" value="&lt;b&gt;Evaluation runner&lt;/b&gt;&lt;br&gt;Base vs tuned on held-out set" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;fontColor=#FFFFFF;strokeColor=#0B4884;fontSize=12;" vertex="1" parent="1"><mxGeometry x="785" y="225" width="150" height="100" as="geometry"/></mxCell><mxCell id="