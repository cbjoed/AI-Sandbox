or=#F5A623;fontColor=#1F2937;strokeColor=#C47A00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="785" y="225" width="150" height="100" as="geometry"/></mxCell><mxCell id="answer" value="&lt;b&gt;Citation formatter&lt;/b&gt;&lt;br&gt;Answer + source links" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;fontColor=#FFFFFF;strokeColor=#0B4884;fontSize=12;" vertex="1" parent="1"><mxGeometry x="975" y="225" width="120" height="100" as="geometry"/></mxCell><mxCell id="e1" value="1. Question" style="endArrow=block;html=1;strokeColor=#334155;fontSize=10;" edge="1" parent="1" source="user" target="query"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="2. Top-k authorized chunks" style="endArrow=block;html=1;strokeColor=#334155;fontSize=10;" edge="1" parent="1" source="query" target="store"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="3. Evidence + provenance" style="endArrow=block;html=1;strokeColor=#334155;fontSize=10;" edge="1" parent="1" source="store" target="context"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="4. Grounded prompt (or abstain)" style="endArrow=block;html=1;strokeColor=#334155;fontSize=10;" edge="1" parent="1" source="context" target="llm"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="5. Generated answer + citations" style="endArrow=block;html=1;strokeColor=#334155;fontSize=10;" edge="1" parent="1" source="llm" target="answer"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="6. Return sourced response" style="endArrow=block;html=1;strokeColor=#334155;fontSize=10;" edge="1" parent="1" source="answer" target="user"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f" value="Dynamic view: retrieval respects authorization filters and preserves provenance through answer formatting; low-evidence behavior should abstain." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;fontColor=#475569;"