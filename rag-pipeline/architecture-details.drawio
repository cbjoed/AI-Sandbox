<mxfile host="app.diagrams.net" version="25.0.3"><diagram id="rag-components" name="3 - Components"><mxGraphModel dx="1100" dy="700" grid="1" gridSize="10" page="1" pageWidth="1100" pageHeight="700"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="RAG Pipeline — C4 Component Diagram" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=20;fontStyle=1;fontColor=#172554;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="850" height="34" as="geometry"/></mxCell><mxCell id="n" value="Expands the RAG application in architecture.drawio into ingestion and query responsibilities; preserve source provenance across both paths." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=12;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="30" y="55" width="1000" height="24" as="geometry"/></mxCell><mxCell id="b" value="RAG application components" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingTop=10;spacingLeft=12;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="205" y="120" width="680" height="465" as="geometry"/></mxCell><mxCell id="source" value="&lt;b&gt;Source connector&lt;/b&gt;&lt;br&gt;Approved files; stable source IDs and versions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;fontColor=#FFFFFF;strokeColor=#0B4884;fontSize=12;" vertex="1" parent="1"><mxGeometry x="250" y="185" width="170" height="95" as="geometry"/></mxCell><mxCell id="parse" value="&lt;b&gt;Parser + chunker&lt;/b&gt;&lt;br&gt;Extract text; chunk with page/section metadata" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;fontColor=#FFFFFF;strokeColor=#0B4884;fontSize=12;" vertex="1" parent="1"><mxGeometry x="495" y="180" width="180" height="105" as="geometry"/></mxCell><mxCell id="index" value="&lt;b&gt;Indexing coordinator&lt;/b&gt;&lt;br&gt;Idempotent upsert, versioning, deletion/re-index workflow" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;fontColor=#FFFFFF;strokeColor=#0B4884;fontSize=12;" vertex="1" parent="1"><mxGeometry x="710" y="185" width="150" height="95" as="geometry"/></mxCell><mxCell id="query" value="&lt;b&gt;Query embedder + retriever&lt;/b&gt;&lt;br&gt;Top-k search with access filters and score threshold" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;fontColor=#FFFFFF;strokeColor=#0B4884;fontSize=12;" vertex="1" parent="1"><mxGeometry x="250" y="390" width="170" height="100" as="geometry"/></mxCell><mxCell id="context" value="&lt;b&gt;Context assembler&lt;/b&gt;&lt;br&gt;Deduplicate, order, budget context; retain citations" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;fontColor=#FFFFFF;strokeColor=#0B4884;fontSize=12;" vertex="1" parent="1"><mxGeometry x="495" y="385" width="180" height="105" as="geometry"/></mxCell><mxCell id="answer" value="&lt;b&gt;Answer generator + citation formatter&lt;/b&gt;&lt;br&gt;Grounded response; abstain when evidence is weak" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;fontColor=#FFFFFF;strokeColor=#0B4884;fontSize=12;" vertex="1" parent="1"><mxGeometry x="710" y="390" width="150" height="100" as="geometry"/></mxCell><mxCell id="vector" value="&lt;b&gt;Vector + metadata store&lt;/b&gt;&lt;br&gt;Vectors, chunks, source IDs, ACL metadata" style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="385" width="170" height="105" as="geometry"/></mxCell><mxCell id="models" value="&lt;b&gt;Embedding / LLM endpoints&lt;/b&gt;&lt;br&gt;External APIs or local models" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5A623;fontColor=#1F2937;strokeColor=#C47A00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="915" y="290" width="155" height="105" as="geometry"/></mxCell><mxCell id="e1" value="document bytes" style="endArrow=block;html=1;strokeColor=#334155;fon