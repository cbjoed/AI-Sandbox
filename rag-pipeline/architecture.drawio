<mxfile host="app.diagrams.net" version="25.0.3"><diagram id="rag-context" name="1 - System Context"><mxGraphModel dx="1100" dy="700" grid="1" gridSize="10" page="1" pageWidth="1100" pageHeight="700"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="RAG Pipeline — C4 System Context (proposed)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#172554;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="850" height="34" as="geometry"/></mxCell><mxCell id="note" value="The design separates document ingestion from interactive retrieval and answer generation; sources remain attributable through citations." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="30" y="55" width="960" height="24" as="geometry"/></mxCell><mxCell id="boundary" value="RAG Application" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingTop=10;spacingLeft=12;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="310" y="145" width="440" height="350" as="geometry"/></mxCell><mxCell id="user" value="&lt;b&gt;Questioner&lt;/b&gt;&lt;br&gt;Person&lt;br&gt;Asks questions and reviews cited answers" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#08427B;fontColor=#FFFFFF;strokeColor=#052E56;fontSize=13;" vertex="1" parent="1"><mxGeometry x="45" y="260" width="205" height="125" as="geometry"/></mxCell><mxCell id="rag" value="&lt;b&gt;RAG application&lt;/b&gt;&lt;br&gt;Software system&lt;br&gt;Indexes approved documents and answers questions using retrieved evidence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;fontColor=#FFFFFF;strokeColor=#0B4884;fontSize=13;" vertex="1" parent="1"><mxGeometry x="415" y="260" width="240" height="125" as="geometry"/></mxCell><mxCell id="docs" value="&lt;b&gt;Document sources&lt;/b&gt;&lt;br&gt;Local files / approved repository&lt;br&gt;Text, Markdown, PDF" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5A623;fontColor=#1F2937;strokeColor=#C47A00;fontSize=13;" vertex="1" parent="1"><mxGeometry x="835" y="165" width="220" height="105" as="geometry"/></mxCell><mxCell id="model" value="&lt;b&gt;Embedding + LLM providers&lt;/b&gt;&lt;br&gt;External APIs or local models&lt;br&gt;Embeddings for indexing/search; generation for answers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5A623;fontColor=#1F2937;strokeColor=#C47A00;fontSize=13;" vertex="1" parent="1"><mxGeometry x="835" y="365" width="220" height="120" as="geometry"/></mxCell><mxCell id="e1" value="asks question / receives cited answer" style="endArrow=block;html=1;rounded=0;strokeColor=#334155;fontSize=11;" edge="1" parent="1" source="user" target="rag"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="ingests documents" style="endArrow=block;html=1;rounded=0;strokeColor=#334155;fontSize=11;" edge="1" parent="1" source="docs" target="rag"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="embedding and generation requests" style="endArrow=block;html=1;rounded=0;strokeColor=#334155;fontSize=11;" edge="1" parent="1" source="rag" target="model"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="legend" value="C4: Person • Software System • External Systems | Preserve source metadata and access controls; answer only from retrieved context and expose citations." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="30" y="625" width="1020" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="rag-containers" name="2 - Containers"><mxGraphModel dx="1100" dy="700" grid="1" gridSize="10" page="1" pageWidth="1100" pageHeight="700"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="RAG Pipeline — C4 Container Diagram (proposed)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#172554;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="850" height="34" as="geometry"/></mxCell><mxCell id="note" value="Offline ingestion and online query paths share a versioned index; provider adapters and metadata make the pipeline portable and auditable." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="30" y="55" width="980" height="24" as="geometry"/></mxCell><mxCell id="boundary" value="RAG application (Python; LangChain / LlamaIndex optional)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingTop=10;spacingLeft=12;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="220" y="120" width="680" height="470" as="geometry"/></mxCell><mxCell id="user" value="&lt;b&gt;Questioner&lt;/b&gt;&lt;br&gt;Person" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#08427B;fontColor=#FFFFFF;strokeColor=#052E56;fontSize=13;" vertex="1" parent="1"><mxGeometry x="30" y="420" width="145" height="105" as="geometry"/></mxCell><mxCell id="ingest" value="&lt;b&gt;Ingestion job&lt;/b&gt;&lt;br&gt;CLI / batch process&lt;br&gt;Incremental, repeatable indexing run" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;fontColor=#FFFFFF;strokeColor=#0B4884;fontSize=12;" vertex="1" parent="1"><mxGeometry x="255" y="170" width="170" height="100" as="geometry"/></mxCell><mxCell id="parse" value="&lt;b&gt;Parser + chunker&lt;/b&gt;&lt;br&gt;Application module&lt;br&gt;Extracts text; creates chunks with stable source/page metadata" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;fontColor=#FFFFFF;strokeColor=#0B4884;fontSize=12;" vertex="1" parent="1"><mxGeometry x="485" y="160" width="190" height="110" as="geometry"/></mxCell><mxCell id="embed" value="&lt;b&gt;Embedding adapter&lt;/b&gt;&lt;br&gt;Application module&lt;br&gt;Batches vectors; records model/version" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;fontColor=#FFFFFF;strokeColor=#0B4884;fontSize=12;" vertex="1" parent="1"><mxGeometry x="735" y="170" width="145" height="100" as="geometry"/></mxCell><mxCell id="query" value="&lt;b&gt;Query service&lt;/b&gt;&lt;br&gt;CLI / API container&lt;br&gt;Embeds question; retrieves top-k authorized chunks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;fontColor=#FFFFFF;strokeColor=#0B4884;fontSize=12;" vertex="1" parent="1"><mxGeometry x="255" y="420" width="170" height="105" as="geometry"/></mxCell><mxCell id="compose" value="&lt;b&gt;Answer composer&lt;/b&gt;&lt;br&gt;Application module&lt;br&gt;Grounded prompt, refusal on weak evidence, source citations" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;fontColor=#FFFFFF;strokeColor=#0B4884;fontSize=12;" vertex="1" parent="1"><mxGeometry x="485" y="420" width="190" height="105" as="geometry"/></mxCell><mxCell id="vector" value="&lt;b&gt;Vector store&lt;/b&gt;&lt;br&gt;Chroma / FAISS / managed DB&lt;br&gt;Vectors, chunk text, source metadata, access labels" style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="735" y="405" width="145" height="125" as="geometry"/></mxCell><mxCell id="docs" value="&lt;b&gt;Source documents&lt;/b&gt;&lt;br&gt;Local folder / approved repository" style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="170" width="145" height="100" as="geometry"/></mxCell><mxCell id="models" value="&lt;b&gt;Embedding + LLM endpoints&lt;/b&gt;&lt;br&gt;External APIs or local models" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5A623;fontColor=#1F2937;strokeColor=#C47A00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="950" y="280" width="145" height="110" as="geometry"/></mxCell><mxCell id="e1" value="approved files" style="endArrow=block;html=1;strokeColor=#334155;fontSize=10;" edge="1" parent="1" source="docs" target="ingest"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="document bytes" style="endArrow=block;html=1;strokeColor=#334155;fontSize=10;" edge="1" parent="1" source="ingest" target="parse"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="chunks + metadata" style="endArrow=block;html=1;strokeColor=#334155;fontSize=10;" edge="1" parent="1" source="parse" target="embed"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="embedding calls" style="endArrow=block;html=1;strokeColor=#334155;fontSize=10;" edge="1" parent="1" source="embed" target="models"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="upsert vectors and metadata" style="endArrow=block;html=1;strokeColor=#334155;fontSize=10;" edge="1" parent="1" source="embed" target="vector"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="question / cited answer" style="endArrow=block;html=1;strokeColor=#334155;fontSize=10;" edge="1" parent="1" source="user" target="query"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="embed query + similarity search" style="endArrow=block;html=1;strokeColor=#334155;fontSize=10;" edge="1" parent="1" source="query" target="vector"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="top-k chunks with provenance" style="endArrow=block;html=1;strokeColor=#334155;fontSize=10;" edge="1" parent="1" source="vector" target="compose"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="grounded generation" style="endArrow=block;html=1;strokeColor=#334155;fontSize=10;" edge="1" parent="1" source="compose" target="models"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="legend" value="Enforce document access before retrieval; preserve chunk-to-source provenance, handle re-indexing/deletion, and never claim unsupported answers." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="30" y="625" width="1030" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>