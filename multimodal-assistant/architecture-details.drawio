<mxfile host="app.diagrams.net" version="25.0.3"><diagram id="multi-components" name="3 - Components"><mxGraphModel dx="1100" dy="700" grid="1" gridSize="10" page="1" pageWidth="1100" pageHeight="700"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Multimodal Assistant — C4 Component Diagram" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=20;fontStyle=1;fontColor=#172554;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="850" height="34" as="geometry"/></mxCell><mxCell id="n" value="Zoom into the assistant application in architecture.drawio; this initial slice focuses on image + optional text input." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=12;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="30" y="55" width="950" height="24" as="geometry"/></mxCell><mxCell id="b" value="Assistant application" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingTop=10;spacingLeft=12;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="205" y="120" width="680" height="465" as="geometry"/></mxCell><mxCell id="ui" value="&lt;b&gt;Upload / prompt interface&lt;/b&gt;&lt;br&gt;Image, question, selected use case" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;fontColor=#FFFFFF;strokeColor=#0B4884;fontSize=12;" vertex="1" parent="1"><mxGeometry x="250" y="195" width="175" height="95" as="geometry"/></mxCell><mxCell id="validator" value="&lt;b&gt;Media validator&lt;/b&gt;&lt;br&gt;MIME/size limits, safe decoding, reject invalid inputs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;fontColor=#FFFFFF;strokeColor=#0B4884;fontSize=12;" vertex="1" parent="1"><mxGeometry x="495" y="190" width="180" height="100" as="geometry"/></mxCell><mxCell id="preprocess" value="&lt;b&gt;Preprocessor&lt;/b&gt;&lt;br&gt;Resize/normalize image; minimize metadata" style="rounded=1;whiteSpace=wrap;html=1;fil