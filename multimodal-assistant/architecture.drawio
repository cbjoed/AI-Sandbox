<mxfile host="app.diagrams.net" version="25.0.3"><diagram id="multi-context" name="1 - System Context"><mxGraphModel dx="1100" dy="700" grid="1" gridSize="10" page="1" pageWidth="1100" pageHeight="700"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Multimodal Assistant — C4 System Context (proposed)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#172554;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="850" height="34" as="geometry"/></mxCell><mxCell id="note" value="Initial scope is image + optional text for visual Q&amp;A, captioning, or OCR/summarization; other modalities can be added behind adapters." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="30" y="55" width="980" height="24" as="geometry"/></mxCell><mxCell id="boundary" value="Multimodal Assistant" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingTop=10;spacingLeft=12;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="310" y="145" width="440" height="350" as="geometry"/></mxCell><mxCell id="user" value="&lt;b&gt;User&lt;/b&gt;&lt;br&gt;Person&lt;br&gt;Provides an image and optional text question; reviews answer" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#08427B;fontColor=#FFFFFF;strokeColor=#052E56;fontSize=13;" vertex="1" parent="1"><mxGeometry x="50" y="260" width="205" height="125" as="geometry"/></mxCell><mxCell id="assistant" value="&lt;b&gt;Multimodal assistant&lt;/b&gt;&lt;br&gt;Software system&lt;br&gt;Validates inputs and returns a grounded response for a chosen use case" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;fontColor=#FFFFFF;strokeColor=#0B4884;fontSize=13;" vertex="1" parent="1"><mxGeometry x="415" y="260" width="240" height="125" as="geometry"/></mxCell><mxCell id="provider" value="&lt;b&gt;Multimodal model provider&lt;/b&gt;&lt;br&gt;External API / optional local model&lt;br&gt;Processes image + text and generates output" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5A623;fontColor=#1F2937;strokeColor=#C47A00;fontSize=13;" vertex="1" parent="1"><mxGeometry x="835" y="260" width="220" height="120" as="geometry"/></mxCell><mxCell id="e1" value="image + optional question / answer" style="endArrow=block;html=1;rounded=0;strokeColor=#334155;fontSize=11;" edge="1" parent="1" source="user" target="assistant"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="image + prompt; generated response" style="endArrow=block;html=1;rounded=0;strokeColor=#334155;fontSize=11;" edge="1" parent="1" source="assistant" target="provider"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="legend" value="C4: Person • Software System • External System | Treat uploaded media as sensitive; disclose external processing and avoid retention unless explicitly needed." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="30" y="625" width="1020" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="multi-containers" name="2 - Containers"><mxGraphModel dx="1100" dy="700" grid="1" gridSize="10" page="1" pageWidth="1100" pageHeight="700"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Multimodal Assistant — C4 Container Diagram (proposed)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#172554;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="850" height="34" as="geometry"/></mxCell><mxCell id="note" value="Keep the application thin and provider-agnostic; minimize media handling and avoid storing uploads by default." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="30" y="55" width="900" height="24" as="geometry"/></mxCell><mxCell id="boundary" value="Assistant application (Python CLI / thin UI)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingTop=10;spacingLeft=12;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="235" y="125" width="640" height="455" as="geometry"/></mxCell><mxCell id="user" value="&lt;b&gt;User&lt;/b&gt;&lt;br&gt;Person" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#08427B;fontColor=#FFFFFF;strokeColor=#052E56;fontSize=13;" vertex="1" parent="1"><mxGeometry x="35" y="275" width="150" height="105" as="geometry"/></mxCell><mxCell id="ui" value="&lt;b&gt;Input interface&lt;/b&gt;&lt;br&gt;CLI / thin UI&lt;br&gt;Image, optional text, use case" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;fontColor=#FFFFFF;strokeColor=#0B4884;fontSize=12;" vertex="1" parent="1"><mxGeometry x="270" y="275" width="165" height="100" as="geometry"/></mxCell><mxCell id="validate" value="&lt;b&gt;Input validation&lt;/b&gt;&lt;br&gt;Application module&lt;br&gt;Type/size checks, safe decoding, metadata minimization" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;fontColor=#FFFFFF;strokeColor=#0B4884;fontSize=12;" vertex="1" parent="1"><mxGeometry x="500" y="175" width="195" height="105" as="geometry"/></mxCell><mxCell id="orchestrator" value="&lt;b&gt;Inference orchestrator&lt;/b&gt;&lt;br&gt;Application container&lt;br&gt;Builds task prompt, selects model adapter, handles response/errors" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;fontColor=#FFFFFF;strokeColor=#0B4884;fontSize=12;" vertex="1" parent="1"><mxGeometry x="500" y="385" width="195" height="115" as="geometry"/></mxCell><mxCell id="temp" value="&lt;b&gt;Temporary media buffer&lt;/b&gt;&lt;br&gt;In-memory / request-scoped&lt;br&gt;No durable retention by default" style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="270" y="430" width="165" height="105" as="geometry"/></mxCell><mxCell id="provider" value="&lt;b&gt;Multimodal provider adapter&lt;/b&gt;&lt;br&gt;Application module&lt;br&gt;Normalizes API and model-specific payloads" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;fontColor=#FFFFFF;strokeColor=#0B4884;fontSize=12;" vertex="1" parent="1"><mxGeometry x="735" y="290" width="125" height="115" as="geometry"/></mxCell><mxCell id="api" value="&lt;b&gt;Model endpoint&lt;/b&gt;&lt;br&gt;External API or local model&lt;br&gt;Vision-capable inference" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5A623;fontColor=#1F2937;strokeColor=#C47A00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="925" y="295" width="155" height="110" as="geometry"/></mxCell><mxCell id="e1" value="media + question" style="endArrow=block;html=1;strokeColor=#334155;fontSize=10;" edge="1" parent="1" source="user" target="ui"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="upload / task" style="endArrow=block;html=1;strokeColor=#334155;fontSize=10;" edge="1" parent="1" source="ui" target="validate"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="validated request" style="endArrow=block;html=1;strokeColor=#334155;fontSize=10;" edge="1" parent="1" source="validate" target="orchestrator"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="request-scoped media" style="endArrow=block;html=1;strokeColor=#334155;fontSize=10;" edge="1" parent="1" source="validate" target="temp"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="inference request / response" style="endArrow=block;html=1;strokeColor=#334155;fontSize=10;" edge="1" parent="1" source="orchestrator" target="provider"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="model-specific call" style="endArrow=block;html=1;strokeColor=#334155;fontSize=10;" edge="1" parent="1" source="provider" target="api"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="legend" value="Enforce upload limits and provider timeouts. Obtain consent before external transmission; keep secrets out of source and logs." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="30" y="625" width="1020" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>