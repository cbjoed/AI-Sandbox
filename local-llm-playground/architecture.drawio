<mxfile host="app.diagrams.net" version="25.0.3"><diagram id="local-context" name="1 - System Context"><mxGraphModel dx="1100" dy="700" grid="1" gridSize="10" page="1" pageWidth="1100" pageHeight="700"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Local LLM Playground — C4 System Context (proposed)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#172554;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="850" height="34" as="geometry"/></mxCell><mxCell id="note" value="A small comparison tool keeps the user experience consistent while allowing local and hosted inference to be compared." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="30" y="55" width="900" height="24" as="geometry"/></mxCell><mxCell id="boundary" value="LLM Comparison Playground" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingTop=10;spacingLeft=12;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="310" y="145" width="440" height="350" as="geometry"/></mxCell><mxCell id="user" value="&lt;b&gt;Experimenter&lt;/b&gt;&lt;br&gt;Person&lt;br&gt;Runs prompts and compares quality, latency, and resource use" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#08427B;fontColor=#FFFFFF;strokeColor=#052E56;fontSize=13;" vertex="1" parent="1"><mxGeometry x="45" y="260" width="220" height="125" as="geometry"/></mxCell><mxCell id="playground" value="&lt;b&gt;Comparison application&lt;/b&gt;&lt;br&gt;Software system&lt;br&gt;Sends comparable prompts to local and hosted models; records measurements" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;fontColor=#FFFFFF;strokeColor=#0B4884;fontSize=13;" vertex="1" parent="1"><mxGeometry x="415" y="260" width="240" height="125" as="geometry"/></mxCell><mxCell id="local" value="&lt;b&gt;Local model runtime&lt;/b&gt;&lt;br&gt;External software system&lt;br&gt;Ollama, llama.cpp, or equivalent; runs downloaded model" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5A623;fontColor=#1F2937;strokeColor=#C47A00;fontSize=13;" vertex="1" parent="1"><mxGeometry x="835" y="160" width="220" height="110" as="geometry"/></mxCell><mxCell id="hosted" value="&lt;b&gt;Hosted model API&lt;/b&gt;&lt;br&gt;External software system&lt;br&gt;Optional comparison endpoint" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5A623;fontColor=#1F2937;strokeColor=#C47A00;fontSize=13;" vertex="1" parent="1"><mxGeometry x="835" y="370" width="220" height="105" as="geometry"/></mxCell><mxCell id="e1" value="selects model and reviews comparison" style="endArrow=block;html=1;rounded=0;strokeColor=#334155;fontSize=11;" edge="1" parent="1" source="user" target="playground"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="prompt / response + timing" style="endArrow=block;html=1;rounded=0;strokeColor=#334155;fontSize=11;" edge="1" parent="1" source="playground" target="local"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="prompt / response + timing (optional)" style="endArrow=block;html=1;rounded=0;strokeColor=#334155;fontSize=11;" edge="1" parent="1" source="playground" target="hosted"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="legend" value="C4: Person • Software System • External Systems | Local inference is the default privacy-friendly path; disclose when prompts leave the device." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="30" y="625" width="1020" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="local-containers" name="2 - Containers"><mxGraphModel dx="1100" dy="700" grid="1" gridSize="10" page="1" pageWidth="1100" pageHeight="700"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Local LLM Playground — C4 Container Diagram (proposed)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#172554;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="850" height="34" as="geometry"/></mxCell><mxCell id="note" value="Provider adapters isolate runtime differences; capture comparable metrics and make data egress explicit." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="30" y="55" width="900" height="24" as="geometry"/></mxCell><mxCell id="boundary" value="Comparison application (CLI / small local UI)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingTop=10;spacingLeft=12;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="240" y="125" width="625" height="455" as="geometry"/></mxCell><mxCell id="user" value="&lt;b&gt;Experimenter&lt;/b&gt;&lt;br&gt;Person" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#08427B;fontColor=#FFFFFF;strokeColor=#052E56;fontSize=13;" vertex="1" parent="1"><mxGeometry x="35" y="275" width="150" height="105" as="geometry"/></mxCell><mxCell id="ui" value="&lt;b&gt;Prompt interface&lt;/b&gt;&lt;br&gt;CLI / thin UI&lt;br&gt;Prompt, model selection, output" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;fontColor=#FFFFFF;strokeColor=#0B4884;fontSize=12;" vertex="1" parent="1"><mxGeometry x="275" y="275" width="155" height="100" as="geometry"/></mxCell><mxCell id="runner" value="&lt;b&gt;Comparison runner&lt;/b&gt;&lt;br&gt;Application container&lt;br&gt;Normalizes request; measures latency and resource/quality metadata" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;fontColor=#FFFFFF;strokeColor=#0B4884;fontSize=12;" vertex="1" parent="1"><mxGeometry x="495" y="260" width="200" height="125" as="geometry"/></mxCell><mxCell id="adapters" value="&lt;b&gt;Provider adapters&lt;/b&gt;&lt;br&gt;Application module&lt;br&gt;Local-runtime and hosted-API interfaces" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;fontColor=#FFFFFF;strokeColor=#0B4884;fontSize=12;" vertex="1" parent="1"><mxGeometry x="495" y="430" width="200" height="95" as="geometry"/></mxCell><mxCell id="results" value="&lt;b&gt;Experiment records&lt;/b&gt;&lt;br&gt;Local CSV / JSONL&lt;br&gt;Prompt id, model/version, timing, measurements, output (opt-in)" style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="275" y="430" width="155" height="105" as="geometry"/></mxCell><mxCell id="local" value="&lt;b&gt;Local inference runtime&lt;/b&gt;&lt;br&gt;Ollama / llama.cpp&lt;br&gt;Model stays on device" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5A623;fontColor=#1F2937;strokeColor=#C47A00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="910" y="180" width="165" height="105" as="geometry"/></mxCell><mxCell id="hosted" value="&lt;b&gt;Hosted inference API&lt;/b&gt;&lt;br&gt;Optional external service&lt;br&gt;Credential from environment/secret store" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5A623;fontColor=#1F2937;strokeColor=#C47A00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="910" y="395" width="165" height="110" as="geometry"/></mxCell><mxCell id="e1" value="prompt / options" style="endArrow=block;html=1;strokeColor=#334155;fontSize=10;" edge="1" parent="1" source="user" target="ui"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="request" style="endArrow=block;html=1;strokeColor=#334155;fontSize=10;" edge="1" parent="1" source="ui" target="runner"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="normalized inference call" style="endArrow=block;html=1;strokeColor=#334155;fontSize=10;" edge="1" parent="1" source="runner" target="adapters"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="local inference" style="endArrow=block;html=1;strokeColor=#334155;fontSize=10;" edge="1" parent="1" source="adapters" target="local"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="optional hosted inference" style="endArrow=block;html=1;strokeColor=#334155;fontSize=10;" edge="1" parent="1" source="adapters" target="hosted"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="response and measurements" style="endArrow=block;html=1;strokeColor=#334155;fontSize=10;" edge="1" parent="1" source="runner" target="results"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="legend" value="Avoid sending sensitive prompts to hosted APIs by default. Record model/runtime versions and do not persist raw prompts or outputs without consent." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="30" y="625" width="1020" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>