;b&gt;Result store&lt;/b&gt;&lt;br&gt;Versioned metrics / records" style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="975" y="225" width="120" height="100" as="geometry"/></mxCell><mxCell id="e1" value="1. Choose task + run settings" style="endArrow=block;html=1;strokeColor=#334155;fontSize=10;" edge="1" parent="1" source="researcher" target="harness"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="2. Load cases + variants" style="endArrow=block;html=1;strokeColor=#334155;fontSize=10;" edge="1" parent="1" source="harness" target="variants"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="3. Issue bounded model calls" style="endArrow=block;html=1;strokeColor=#334155;fontSize=10;" edge="1" parent="1" source="variants" target="model"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="4. Return outputs + usage metadata" style="endArrow=block;html=1;strokeColor=#334155;fontSize=10;" edge="1" parent="1" source="model" target="eval"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="5. Persist scores + provenance" style="endArrow=block;html=1;strokeColor=#334155;fontSize=10;" edge="1" parent="1" source="eval" target="store"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f" value="Dynamic view: execution for one case/variant group; repeated batches and human-review loops are omitted." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="30" y="625" width="1020" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>