<mxfile host="app.diagrams.net" version="25.0.3"><diagram id="prompt-components" name="3 - Components"><mxGraphModel dx="1100" dy="700" grid="1" gridSize="10" page="1" pageWidth="1100" pageHeight="700"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Prompt Engineering Lab — C4 Component Diagram" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=20;fontStyle=1;fontColor=#172554;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="850" height="34" as="geometry"/></mxCell><mxCell id="n" value="Zoom into the experiment harness from architecture.drawio; prompt variants and benchmark cases are versioned inputs." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=12;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="30" y="55" width="960" height="24" as="geometry"/></mxCell><mxCell id="b" value="Prompt experiment harness" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingTop=10;spacingLeft=12;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="205" y="120" width="680" height="465" as="geometry"/></mxCell><mxCell id="entry" value="&lt;b&gt;Experiment entry point&lt;/b&gt;&lt;br&gt;Task, model, run parameters" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;fontColor=#FFFFFF;strokeColor=#0B4884;fontSize=12;" vertex="1" parent="1"><mxGeometry x="250" y="195" width="170" height="95" as="geometry"/></mxCell><mxCell id="loader" value="&lt;b&gt;Case loader&lt;/b&gt;&lt;br&gt;Versioned examples and expected outputs (if applicable)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;fontColor=#FFFFFF;strokeColor=#0B4884;fontSize=12;" vertex="1" parent="1"><mxGeometry x="495" y="190" width="180" height="100" as="geometry"/></mxCell><mxCell id="template" value="&lt;b&gt;Variant templater&lt;/b&gt;&lt;br&gt;Zero-shot, few-shot, structured output variants" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;fontColor=#FFFFFF;strokeColor=#0B4884;fontSize=12;" vertex="1" parent="1"><mxGeometry x="710" y="195" width="150" height="95" as="geometry"/></mxCell><mxCell id="runner" value="&lt;b&gt;Batch runner&lt;/b&gt;&lt;br&gt;Controlled parameters, bounded concurrency, retries/timeouts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;fontColor=#FFFFFF;strokeColor=#0B4884;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="390" width="175" height="95" as="geometry"/></mxCell><mxCell id="eval" value="&lt;b&gt;Evaluator&lt;/b&gt;&lt;br&gt;Task metrics, format/schema checks, optional human review" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;fontColor=#FFFFFF;strokeColor=#0B4884;fontSize=12;" vertex="1" parent="1"><mxGeometry x="545" y="390" width="180" height="95" as="geometry"/></mxCell><mxCell id="writer" value="&lt;b&gt;Result writer&lt;/b&gt;&lt;br&gt;Versioned records; outputs stored only as configured" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;fontColor=#FFFFFF;strokeColor=#0B4884;fontSize=12;" vertex="1" parent="1"><mxGeometry x="745" y="390" width="115" height="100" as="geometry"/></mxCell><mxCell id="store" value="&lt;b&gt;Benchmark + results store&lt;/b&gt;&lt;br&gt;CSV / JSONL / notebook artifact" style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="390" width="145" height="100" as="geometry"/></mxCell><mxCell id="model" value="&lt;b&gt;LLM endpoint&lt;/b&gt;&lt;br&gt;External API or local model" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5A623;fontColor=#1F2937;strokeColor=#C47A00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="915" y="390" width="155" height="100" as="geometry"/></mxCell><mxCell id="e1" value="run settings" style="endArrow=block;html=1;strokeColor=#334155;fontSize=10;" edge="1" parent="1" source="entry" target="loader"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="cases + variants" style="endArrow=block;html=1;strokeColor=#334155;fontSize=10;" edge="1" parent="1" source="loader" target="template"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="rendered prompt cases" style="endArrow=block;html=1;strokeColor=#334155;fontSize=10;" edge="1" parent="1" source="template" target="runner"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="model calls / outputs" style="endArrow=block;html=1;strokeColor=#334155;fontSize=10;" edge="1" parent="1" source="runner" target="model"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="score outputs" style="endArrow=block;html=1;strokeColor=#334155;fontSize=10;" edge="1" parent="1" source="runner" target="eval"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="metrics + selected output fields" style="endArrow=block;html=1;strokeColor=#334155;fontSize=10;" edge="1" parent="1" source="eval" target="writer"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="append experiment records" style="endArrow=block;html=1;strokeColor=#334155;fontSize=10;" edge="1" parent="1" source="writer" target="store"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f" value="Evaluate observable task behavior, not hidden reasoning. Pin prompt, model, and parameter versions for valid comparisons." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="30" y="625" width="1020" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="prompt-dynamic" name="4 - Dynamic - Run Benchmark"><mxGraphModel dx="1100" dy="700" grid="1" gridSize="10" page="1" pageWidth="1100" pageHeight="700"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Prompt Engineering Lab — Dynamic Diagram: Run Benchmark" style="text;html=1;strokeColor=none;fillColor=none;align=lef