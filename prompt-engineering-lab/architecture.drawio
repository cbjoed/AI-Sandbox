<mxfile host="app.diagrams.net" version="25.0.3"><diagram id="prompt-context" name="1 - System Context"><mxGraphModel dx="1100" dy="700" grid="1" gridSize="10" page="1" pageWidth="1100" pageHeight="700"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Prompt Engineering Lab — C4 System Context (proposed)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#172554;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="850" height="34" as="geometry"/></mxCell><mxCell id="note" value="Systematically evaluates prompt variants on a fixed task; records outputs and measurable quality signals for reproducible comparison." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="30" y="55" width="960" height="24" as="geometry"/></mxCell><mxCell id="boundary" value="Prompt Experiment Lab" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingTop=10;spacingLeft=12;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="310" y="145" width="440" height="350" as="geometry"/></mxCell><mxCell id="user" value="&lt;b&gt;Researcher&lt;/b&gt;&lt;br&gt;Person&lt;br&gt;Defines benchmark, variants, and evaluation criteria" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#08427B;fontColor=#FFFFFF;strokeColor=#052E56;fontSize=13;" vertex="1" parent="1"><mxGeometry x="50" y="260" width="205" height="125" as="geometry"/></mxCell><mxCell id="lab" value="&lt;b&gt;Prompt experiment harness&lt;/b&gt;&lt;br&gt;Software system&lt;br&gt;Runs controlled variations and summarizes observed performance" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;fontColor=#FFFFFF;strokeColor=#0B4884;fontSize=13;" vertex="1" parent="1"><mxGeometry x="415" y="260" width="240" height="125" as="geometry"/></mxCell><mxCell id="llm" value="&lt;b&gt;LLM endpoint&lt;/b&gt;&lt;br&gt;External API or local model&lt;br&gt;Returns model output for each experiment case" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5A623;fontColor=#1F2937;strokeColor=#C47A00;fontSize=13;" vertex="1" parent="1"><mxGeometry x="835" y="260" width="220" height="120" as="geometry"/></mxCell><mxCell id="e1" value="configures runs / reviews findings" style="endArrow=block;html=1;rounded=0;strokeColor=#334155;fontSize=11;" edge="1" parent="1" source="user" target="lab"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="prompt variants + benchmark cases" style="endArrow=block;html=1;rounded=0;strokeColor=#334155;fontSize=11;" edge="1" parent="1" source="lab" target="llm"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="legend" value="C4: Person • Software System • External System | Compare answer quality/format and task metrics; do not treat hidden chain-of-thought as an evaluation artifact." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="30" y="625" width="1020" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="prompt-containers" name="2 - Containers"><mxGraphModel dx="1100" dy="700" grid="1" gridSize="10" page="1" pageWidth="1100" pageHeight="700"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Prompt Engineering Lab — C4 Container Diagram (proposed)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#172554;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="850" height="34" as="geometry"/></mxCell><mxCell id="note" value="A lightweight Python script/notebook can implement this design; deterministic cases and versioned variants enable fair comparisons." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="30" y="55" width="960" height="24" as="geometry"/></mxCell><mxCell id="boundary" value="Experiment harness (Python script / notebook)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingTop=10;spacingLeft=12;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="230" y="125" width="640" height="455" as="geometry"/></mxCell><mxCell id="user" value="&lt;b&gt;Researcher&lt;/b&gt;&lt;br&gt;Person" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#08427B;fontColor=#FFFFFF;strokeColor=#052E56;fontSize=13;" vertex="1" parent="1"><mxGeometry x="35" y="275" width="150" height="105" as="geometry"/></mxCell><mxCell id="entry" value="&lt;b&gt;Experiment entry point&lt;/b&gt;&lt;br&gt;CLI / notebook&lt;br&gt;Task, model, and run settings" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;fontColor=#FFFFFF;strokeColor=#0B4884;fontSize=12;" vertex="1" parent="1"><mxGeometry x="265" y="275" width="165" height="100" as="geometry"/></mxCell><mxCell id="runner" value="&lt;b&gt;Variant runner&lt;/b&gt;&lt;br&gt;Application container&lt;br&gt;Zero-shot, few-shot, structured output; controlled model parameters" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;fontColor=#FFFFFF;strokeColor=#0B4884;fontSize=12;" vertex="1" parent="1"><mxGeometry x="495" y="255" width="195" height="120" as="geometry"/></mxCell><mxCell id="eval" value="&lt;b&gt;Evaluator&lt;/b&gt;&lt;br&gt;Application module&lt;br&gt;Task metrics, schema checks, optional human review" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;fontColor=#FFFFFF;strokeColor=#0B4884;fontSize=12;" vertex="1" parent="1"><mxGeometry x="495" y="430" width="195" height="95" as="geometry"/></mxCell><mxCell id="store" value="&lt;b&gt;Experiment store&lt;/b&gt;&lt;br&gt;Versioned CSV / JSONL&lt;br&gt;Cases, prompt versions, settings, outputs (opt-in), metrics" style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="265" y="430" width="165" height="105" as="geometry"/></mxCell><mxCell id="adapter" value="&lt;b&gt;Model adapter&lt;/b&gt;&lt;br&gt;Application module&lt;br&gt;Provider-neutral request/response interface" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;fontColor=#FFFFFF;strokeColor=#0B4884;fontSize=12;" vertex="1" parent="1"><mxGeometry x="735" y="275" width="120" height="100" as="geometry"/></mxCell><mxCell id="model" value="&lt;b&gt;Model endpoint&lt;/b&gt;&lt;br&gt;External API or local model" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5A623;fontColor=#1F2937;strokeColor=#C47A00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="920" y="275" width="160" height="100" as="geometry"/></mxCell><mxCell id="cases" value="&lt;b&gt;Benchmark cases&lt;/b&gt;&lt;br&gt;Curated, versioned inputs and expected outputs where applicable" style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="265" y="155" width="165" height="95" as="geometry"/></mxCell><mxCell id="e1" value="defines and inspects" style="endArrow=block;html=1;strokeColor=#334155;fontSize=10;" edge="1" parent="1" source="user" target="entry"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="run configuration" style="endArrow=block;html=1;strokeColor=#334155;fontSize=10;" edge="1" parent="1" source="entry" target="runner"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="versioned cases" style="endArrow=block;html=1;strokeColor=#334155;fontSize=10;" edge="1" parent="1" source="cases" target="runner"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="variant requests / outputs" style="endArrow=block;html=1;strokeColor=#334155;fontSize=10;" edge="1" parent="1" source="runner" target="adapter"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="inference calls" style="endArrow=block;html=1;strokeColor=#334155;fontSize=10;" edge="1" parent="1" source="adapter" target="model"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="scores and checks" style="endArrow=block;html=1;strokeColor=#334155;fontSize=10;" edge="1" parent="1" source="runner" target="eval"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="append experiment records" style="endArrow=block;html=1;strokeColor=#334155;fontSize=10;" edge="1" parent="1" source="eval" target="store"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="legend" value="Pin model/version and parameters. Prefer deterministic scoring and blinded human review; exclude hidden reasoning from stored data and metrics." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="30" y="625" width="1020" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>